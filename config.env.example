# DigiCash API Configuration
# Copy this file to config.env and fill in real values (NEVER commit config.env)

# Merchant Credentials (provided by DigiCash)
DIGICASH_SERVICE_ID=your_service_id
DIGICASH_PASSWORK=your_passwork
DIGICASH_SECRET_KEY=your_secret_key

# API Base URL
DIGICASH_BASE_URL=https://api.fastpayph.com

# Server Configuration
PORT=3000
NODE_ENV=production

# Callback URL (publicly accessible HTTPS endpoint)
# Format: https://your-domain.com/api/callback
CALLBACK_URL=https://your-domain.com/api/callback
RETURN_URL=https://your-domain.com/payment/return

# Test Configuration
TEST_AMOUNT_MINOR_UNITS=10000
TEST_CURRENCY=PHP